# Copiá este archivo a .env.local y completalo. Nunca subas .env.local al repo.

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Clave publishable (sb_publishable_...): pública, respeta RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secret (sb_secret_...): se saltea RLS. Seed, tests y, desde el E6, el
# servidor (confirmar el pago de la seña). Nunca en el navegador ni con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Mercado Pago → Tus integraciones → tu aplicación (ver docs/pagos.md).
# Access token: de prueba (TEST-...) o de producción (APP_USR-...). Solo servidor.
MP_ACCESS_TOKEN=
# Clave secreta de los webhooks (Webhooks → Configurar notificaciones). Solo servidor.
MP_WEBHOOK_SECRET=
# URL pública del sitio, para las back_urls y el webhook de MP. En producción,
# el dominio (https://...). Vacía: https://$VERCEL_URL o http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Carpeta con las fotos del catálogo (la que tiene catalogo.json y fotos/).
CATALOGO_FOTOS_DIR=
