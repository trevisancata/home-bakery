# Copiá este archivo a .env.local y completalo. Nunca subas .env.local al repo.

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Clave publishable (sb_publishable_...): pública, respeta RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secret (sb_secret_...): se saltea RLS. Solo para el seed y los tests.
SUPABASE_SECRET_KEY=

# Carpeta con las fotos del catálogo (la que tiene catalogo.json y fotos/).
CATALOGO_FOTOS_DIR=
